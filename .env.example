# ---------------------------------------------------------------------------
# Space Apps 10 — credenciales OPCIONALES
# Copiá este archivo como .env y completá solo lo que tengas.
# NUNCA subas .env al repositorio. Todas las apps funcionan sin claves
# usando datos abiertos o el subset de respaldo en data/respaldo/.
# ---------------------------------------------------------------------------

# Puerto del servidor (default 3000)
PORT=3000

# NASA: FIRMS (focos de calor) y Earthdata/GES DISC.
# Registro gratuito: https://urs.earthdata.nasa.gov/ y https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_KEY=
EARTHDATA_USER=
EARTHDATA_PASS=

# ESA Copernicus Data Space (cuenta gratuita). Solo necesaria para descargar
# productos; el catálogo OData/STAC es abierto sin token.
CDSE_USER=
CDSE_PASS=

# Emiratos Árabes — EMM SDC (Hope). Cuenta gratuita.
EMM_USER=
EMM_PASS=

# Alertas SMS (opcional, demo). Si no está configurado, la app simula el envío.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
